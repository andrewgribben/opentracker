# Copy to .env for docker compose. Use the address you open in your browser.
HOST_PORT=3000
APPDATA_PATH=./data
DASHBOARD_URL=http://localhost:3000
TZ=Europe/London
PUID=99
PGID=100
UMASK=002
# Blank generates a persistent secret inside appdata.
SESSION_SECRET=
# Blank selects Secure cookies automatically for HTTPS DASHBOARD_URL.
COOKIE_SECURE=
# Enable only behind a reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
